# Environment Variables for Render Deployment
# Copy these to Render Environment Variables in Dashboard

# API Configuration
GROQ_API_KEY=your_groq_api_key_here
# Obrigatória: gere um valor próprio (ex: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEY=generate_your_own_key_here

# Directories for Render (uses persistent disk)
# Persistent disk is mounted at /var/data
PDF_DIR=/var/data/pdfs
CHROMA_PERSIST_DIR=/var/data/chroma

# Models (optional overrides)
# multilingual-e5-large estoura os 512MB de RAM do free tier do Render — use
# o small (default do código) a menos que esteja num plano com mais memória.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Origin
UNITY_ORIGIN=https://your-unity-app.com

# Optional: Eager initialization
# EAGER_RAG_INIT=false

# Optional: Enable reranking
# ENABLE_RERANKER=false
