# ============================================================================
# IC Metaverso RAG API - Configuração de Variáveis de Ambiente
# ============================================================================

# Groq API Key (obtenha em https://console.groq.com/keys)
GROQ_API_KEY=sua_chave_groq_aqui

# ChromaDB Persistence Directory
# Local: ./chroma_db
# Render com Disk: /var/data/chroma
CHROMA_PERSIST_DIR=./chroma_db

# PDF Directory (onde estão os documentos para ingestão)
# Local: ./pdfs ou ./Data
# Render com Disk: /var/data/pdfs
PDF_DIR=./Data

# ============================================================================
# Segurança e Autenticação
# ============================================================================

# API Key para autenticação via header X-API-Key
# Obrigatória: sem essa variável definida, o servidor rejeita todas as
# requisições autenticadas (fail-closed). Gere um valor próprio, ex:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=gere_uma_chave_propria_aqui

# ============================================================================
# CORS - Para integração com Unity e aplicações web
# ============================================================================

# Origem permitida para requisições CORS (cliente Unity em produção)
# Exemplos:
# - Local: http://localhost:3000
# - Produção: https://seu-dominio.com
# - WebGL Unity: https://seu-jogo-unity.com
UNITY_ORIGIN=http://localhost:3000

# ============================================================================
# Modelos e Parâmetros (opcional - já tem defaults em config.py)
# ============================================================================

# Embedding Model (default: intfloat/multilingual-e5-large)
# EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large

# Cross Encoder Model (default: BAAI/bge-reranker-v2-m3)
# CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3

# Groq Model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
